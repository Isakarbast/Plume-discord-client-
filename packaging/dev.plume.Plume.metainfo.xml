  <name>Plume</name>
  <summary>A lightweight native Discord client</summary>
  <description>
    <p>
      Plume is a Discord client written in Rust with GTK 4 and libadwaita, without
      Electron or an embedded browser. It uses a fraction of the memory of the official client.
    </p>
    <p>
      Plume is not affiliated with Discord. Third-party clients are against Discord's
      Terms of Service; use it at your own risk.
    </p>
  </description>
  <launchable type="desktop-id">dev.plume.Plume.desktop</launchable>
